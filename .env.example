# Supabase: Connect > Transaction pooler. Server-only; never use NEXT_PUBLIC_.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres

# Without DATABASE_URL, local development uses ./data/class-league.sqlite.
# CLASS_LEAGUE_DB=C:/class-league-data/class-league.sqlite

# Vercel automatically requires secure cookies. Other HTTPS hosts set this to 1.
# COOKIE_SECURE=1
